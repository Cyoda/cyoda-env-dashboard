################################################################################
# ⚠️  WARNING: THIS FILE IS FOR STANDALONE PACKAGE DEVELOPMENT ONLY!
################################################################################
#
# This configuration is NOT used by the main SaaS application (apps/saas-app).
#
# For SaaS app configuration, edit:
#   → apps/saas-app/.env
#   → apps/saas-app/.env.example
#
# This file is used ONLY when developing individual packages in standalone mode.
#
# To use this configuration:
#   1. Copy this file to .env.development.local
#   2. Adjust the values for your local backend
#   3. Run the package in standalone mode: npm run dev -w packages/package-name
#
################################################################################

# Cyoda Environment Configuration Template
# Copy this file to .env.development.local or .env.production and configure for your environment

# ============================================================================
# API Configuration
# ============================================================================

# Main API Base URL
# Local development: http://localhost:8082/api
# Remote development: https://cyoda-develop.kube.cyoda.org/api
VITE_APP_API_BASE=http://localhost:8082/api

# Processing API Base URL
# Local development: http://localhost:8081/processing
# Remote development: https://cyoda-develop.kube.cyoda.org/processing
VITE_APP_API_BASE_PROCESSING=http://localhost:8081/processing

# Base URL for the application
# Local development: http://localhost:8081/
# Remote development: https://cyoda-develop.kube.cyoda.org
VITE_APP_BASE_URL=http://localhost:8081/

# ============================================================================
# Grafana Configuration
# ============================================================================

# Grafana API URL
VITE_APP_GRAFANA_API_URL=https://grafana.cyoda.com/api

# Grafana API Key
VITE_APP_GRAFANA_API_KEY=<some-key>

# Grafana Server Source ID
VITE_APP_GRAFANA_SERVER_SOURCE_ID=1

# Grafana Username (optional)
# VITE_APP_GRAFANA_USERNAME=

# Grafana Password (optional)
# VITE_APP_GRAFANA_PASSWORD=

# ============================================================================
# OIDC Login (optional; one provider per build)
# ============================================================================
# Shows a "Login with {DISPLAY_NAME}" button when ISSUER and CLIENT_ID are set.
# Redirect URI to register at the IdP: {origin}/oidc/callback
# Post-logout URI to register at the IdP: {origin}/login

# VITE_APP_OIDC_DISPLAY_NAME=SSO
# VITE_APP_OIDC_ISSUER=
# VITE_APP_OIDC_CLIENT_ID=
# VITE_APP_OIDC_SCOPES=openid profile email offline_access
# VITE_APP_OIDC_EXTRA_PARAMS=
# VITE_APP_OIDC_LOGOUT_URL=

# ============================================================================
# Debug & Development
# ============================================================================

# Enable debug mode
VITE_APP_DEBUG=true

# ============================================================================
# Feature Flags
# ============================================================================

# Enable ChatBot feature
# VITE_FEATURE_FLAG_CHATBOT=false

# Enable Models Info feature (uses /platform-api/entity-info/fetch/models-info endpoint)
VITE_FEATURE_FLAG_USE_MODELS_INFO=true

# Enable Cyoda Cloud mode
# When enabled, uses Cyoda Cloud API endpoints:
# - /model/export/SIMPLE_VIEW/{entityName}/{modelVersion} for entity models
# - /entity/{entityId} for entity data
VITE_FEATURE_FLAG_IS_CYODA_CLOUD=true

# Enable Cyoda-Go mode
# Cyoda-Go is a digital twin of Cyoda Cloud that does NOT expose any of the
# legacy /platform-* endpoints. Implies VITE_FEATURE_FLAG_IS_CYODA_CLOUD=true.
# Hides Reporting, Tasks, and Processing from the menu.
# VITE_FEATURE_FLAG_IS_CYODA_GO=false

# Enable Trino SQL Schema page
VITE_FEATURE_FLAG_TRINO_SQL_SCHEMA=true

# Enable Tasks page
# VITE_FEATURE_FLAG_TASKS=false

# ============================================================================
# AI Configuration (optional)
# ============================================================================

# AI API Base URL
# VITE_APP_AI_BASE=

# ============================================================================
# Deployment Configuration (Production only)
# ============================================================================

# Public path for deployment
# VITE_PUBLIC_PATH=/

# Alternative public path (if not empty, will be used as VITE_PUBLIC_PATH)
# VITE_APP_PUBLIC_PATH=/

# ============================================================================
# CONFIGURATION PRESETS
# ============================================================================

# ----------------------------------------------------------------------------
# LOCAL DEVELOPMENT PRESET
# ----------------------------------------------------------------------------
# Uncomment these lines for local development:
#
# VITE_APP_API_BASE=http://localhost:8082/api
# VITE_APP_API_BASE_PROCESSING=http://localhost:8081/processing
# VITE_APP_BASE_URL=http://localhost:8081/
# VITE_APP_DEBUG=true

# ----------------------------------------------------------------------------
# REMOTE DEVELOPMENT PRESET (cyoda-develop)
# ----------------------------------------------------------------------------
# Uncomment these lines for remote development environment:
#
# VITE_APP_API_BASE=https://cyoda-develop.kube.cyoda.org/api
# VITE_APP_API_BASE_PROCESSING=https://cyoda-develop.kube.cyoda.org/processing
# VITE_APP_BASE_URL=https://cyoda-develop.kube.cyoda.org
# VITE_APP_DEBUG=true

# ----------------------------------------------------------------------------
# PRODUCTION PRESET
# ----------------------------------------------------------------------------
# Uncomment these lines for production:
#
# VITE_APP_API_BASE=https://your-production-domain.com/api
# VITE_APP_API_BASE_PROCESSING=https://your-production-domain.com/processing
# VITE_APP_BASE_URL=https://your-production-domain.com
# VITE_APP_DEBUG=false
# VITE_PUBLIC_PATH=/

