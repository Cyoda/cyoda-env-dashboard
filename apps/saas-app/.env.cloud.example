# Example: dashboard against a Cyoda Cloud instance, logging in with Auth0
# (tenant auth.cyoda.net).
#
# Derived from a former local apps/saas-app/.env. The Cloud instances it pointed
# at have been torn down, so treat the URLs as illustrations.
# To use: copy to apps/saas-app/.env and adjust VITE_APP_BASE_URL.

# ============================================================================
# API Configuration
# ============================================================================
# With the Vite dev proxy, keep the API bases relative; the proxy forwards
# them to VITE_APP_BASE_URL.
VITE_APP_API_BASE=/api
VITE_APP_API_BASE_PROCESSING=/api

# The Cloud instance's client URL (instances follow this pattern):
VITE_APP_BASE_URL=https://client-<instance-id>-dev.eu.cyoda.net
# VITE_APP_BASE_URL=https://client-<instance-id>-dev.kube3.cyoda.org

# ============================================================================
# Feature flags
# ============================================================================
VITE_FEATURE_FLAG_IS_CYODA_CLOUD=true
VITE_FEATURE_FLAG_IS_CYODA_GO=false
VITE_FEATURE_FLAG_USE_MODELS_INFO=true
VITE_FEATURE_FLAG_ENTITY_VIEWER_USE_JSON=true
VITE_FEATURE_FLAG_CHATBOT=false
VITE_FEATURE_FLAG_TRINO_SQL_SCHEMA=true

# ============================================================================
# Grafana
# ============================================================================
VITE_APP_GRAFANA_API_URL=https://grafana.cyoda.com/api
VITE_APP_GRAFANA_SERVER_SOURCE_ID=1

# ============================================================================
# OIDC login: Auth0 (Cyoda Cloud tenant)
# ============================================================================
# Client and organization IDs of a public SPA client are not secrets.
# The Auth0 application must allow, for the origin you run on:
#   Allowed Callback URLs  {origin}/oidc/callback
#   Allowed Logout URLs    {origin}/login
#   Allowed Web Origins    {origin}
VITE_APP_OIDC_DISPLAY_NAME=Auth0
VITE_APP_OIDC_ISSUER=https://auth.cyoda.net/
VITE_APP_OIDC_CLIENT_ID=uMTr9wXfQduPUxJcwlMfN7KcWqhILF5v
VITE_APP_OIDC_EXTRA_PARAMS=audience=https://cloud.cyoda.com/api&organization=org_Wk2uUlP29nu96VK1
# auth.cyoda.net advertises no end_session_endpoint, so logout uses Auth0's /v2/logout.
VITE_APP_OIDC_LOGOUT_URL=https://auth.cyoda.net/v2/logout?client_id=uMTr9wXfQduPUxJcwlMfN7KcWqhILF5v&returnTo=http%3A%2F%2Flocalhost%3A5173%2Flogin

# ============================================================================
# Debug
# ============================================================================
VITE_PROXY_LOG=false
VITE_APP_DEBUG=true

# ============================================================================
# Test credentials (E2E, password login)
# ============================================================================
# TEST_ENV_USER=demo.user
# TEST_ENV_SECRET=<password>
