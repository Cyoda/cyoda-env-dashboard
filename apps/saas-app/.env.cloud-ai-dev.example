# Example: dashboard against the Cyoda AI dev backend on kube3, logging in with
# the Auth0 dev tenant (dev-ex6r-yqc.us.auth0.com).
#
# Derived from a former local apps/saas-app/.env.patrick. The backend has been
# torn down, so treat the URLs as illustrations.
# To use: copy to apps/saas-app/.env.
#
# Dropped from the original because no code reads them any more:
# VITE_APP_API_AUTH, VITE_APP_CYODA_CLIENT_HOST, VITE_APP_CYODA_CLIENT_ENV_PREFIX,
# VITE_APP_QUESTION_POLLING_INTERVAL_MS, VITE_APP_QUESTION_MAX_POLLING_INTERVAL,
# VITE_APP_AUTH0_REDIRECT_URI.

# ============================================================================
# API Configuration
# ============================================================================
# Full URL: calls go straight to the backend instead of through the Vite proxy.
VITE_APP_API_BASE=https://ai-dev.kube3.cyoda.org/api

# ============================================================================
# Feature flags
# ============================================================================
VITE_FEATURE_FLAG_IS_CYODA_CLOUD=true
VITE_FEATURE_FLAG_IS_CYODA_GO=false

# ============================================================================
# OIDC login: Auth0 (dev tenant)
# ============================================================================
# The Auth0 application must allow, for the origin you run on:
#   Allowed Callback URLs  {origin}/oidc/callback
#   Allowed Logout URLs    {origin}/login
#   Allowed Web Origins    {origin}
VITE_APP_OIDC_DISPLAY_NAME=Auth0
VITE_APP_OIDC_ISSUER=https://dev-ex6r-yqc.us.auth0.com/
VITE_APP_OIDC_CLIENT_ID=60xVTHeGqqwkVXP0xdJlEOLI1DyIFaPy
VITE_APP_OIDC_EXTRA_PARAMS=audience=https://cloud.cyoda.com/api&organization=org_tWMI2w9Kd0EhwwLo
# This tenant advertises no end_session_endpoint, so logout uses Auth0's /v2/logout.
VITE_APP_OIDC_LOGOUT_URL=https://dev-ex6r-yqc.us.auth0.com/v2/logout?client_id=60xVTHeGqqwkVXP0xdJlEOLI1DyIFaPy&returnTo=http%3A%2F%2Flocalhost%3A5173%2Flogin
